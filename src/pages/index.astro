---
import { getCollection } from "astro:content";
import { toEntity, toGuide } from "../data/schema";
import { todayIso, type Content } from "../domain/content";
import Base from "../layouts/Base.astro";
import MeRobaronApp from "../ui/MeRobaronApp.vue";
import StaticFallback from "../ui/StaticFallback.astro";

// Imported as Astro images: `?url` paths only load inside <img> on the dev server, not when opened as a page.
const screenshots = import.meta.glob<ImageMetadata>("../../content/co/evidencia/*.png", {
  eager: true,
  import: "default",
});

const logos = import.meta.glob<string>("../../content/co/logos/*.png", {
  eager: true,
  query: "?url",
  import: "default",
});

const content: Content = {
  entities: (await getCollection("entidades")).map((entry) => {
    const entity = toEntity(entry.data);
    return {
      ...entity,
      evidence: entity.evidence && screenshots[`../../${entity.evidence}`]?.src,
      logo: logos[`../../content/co/logos/${entity.id}.png`],
    };
  }),
  guides: (await getCollection("guias")).map((entry) => toGuide(entry.data)),
};
const buildDate = todayIso();
const generalGuide = content.guides.find((guide) => guide.id === "general");
---

<Base>
  <MeRobaronApp client:load content={content} buildDate={buildDate} />
  <noscript>
    <StaticFallback guide={generalGuide} />
  </noscript>
  <StaticFallback guide={generalGuide} id="app-fallback" hidden />
</Base>

<script>
  // Flow G: if the interactive plan never hydrates (a script failed to load), show the basic steps.
  window.addEventListener("load", function () {
    setTimeout(function () {
      if (document.querySelector("[data-ready]")) return;
      const fallback = document.getElementById("app-fallback");
      if (fallback) fallback.hidden = false;
    }, 4000);
  });
</script>
