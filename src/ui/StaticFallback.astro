---
import type { Guide } from "../domain/content";

interface Props {
  guide?: Guide;
  id?: string;
  hidden?: boolean;
}

const { guide, id, hidden } = Astro.props;
const home = `${import.meta.env.BASE_URL}/`.replace("//", "/");
---

<section class="fallback container" id={id} hidden={hidden} aria-labelledby={id ? `${id}-title` : undefined}>
  <h2 id={id ? `${id}-title` : undefined} class="fallback__title">
    Lo básico, mientras carga
  </h2>
  <p>No pudimos cargar el plan interactivo. Estos pasos sirven para cualquier robo:</p>
  {guide && (
    <ol class="fallback__steps">
      {guide.steps.map((step) => (
        <li>{step}</li>
      ))}
    </ol>
  )}
  <a class="fallback__retry" href={home}>
    Reintentar
  </a>
</section>

<style>
  .fallback {
    display: grid;
    gap: var(--space-md);
    padding-block: var(--space-xl);
    font-size: 18px;
    line-height: 1.5;
  }

  .fallback[hidden] {
    display: none;
  }

  .fallback__title {
    margin: 0;
    font-size: 24px;
  }

  .fallback p {
    margin: 0;
  }

  .fallback__steps {
    display: grid;
    gap: var(--space-xs);
    margin: 0;
    padding-left: var(--space-lg);
  }

  .fallback__retry {
    justify-self: start;
    padding: var(--space-sm) var(--space-lg);
    background: var(--color-accent-main);
    color: var(--color-ink);
    font-weight: 700;
  }

  .fallback__retry:focus-visible {
    outline: var(--border-thick) solid var(--color-info);
    outline-offset: var(--space-3xs);
  }
</style>
