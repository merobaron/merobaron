---
import "@fontsource/anton/400.css";
import "@fontsource/archivo/400.css";
import "@fontsource/archivo/600.css";
import "@fontsource/archivo/700.css";
import "../ui/tokens.css";
import SiteFooter from "../ui/SiteFooter.astro";
import SiteHeader from "../ui/SiteHeader.astro";

const faviconUrl = `${import.meta.env.BASE_URL}/favicon.svg`.replace("//", "/");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta
      name="description"
      content="Guía abierta para saber qué hacer después de un robo: bloqueos, claves y denuncia, sin registro."
    />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <title>MeRobaron</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <SiteHeader />

    <div class="notice" role="status">
      <p class="container">
        Sitio en construcción. Los nombres, teléfonos y enlaces son de ejemplo y no están verificados. Si te acaban de robar, contacta a tu banco y a tu operador por sus canales oficiales.
      </p>
    </div>

    <main id="contenido" tabindex="-1">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>

<script>
  // Flow G: cache the site so a saved plan still opens without a connection. Production only.
  if (import.meta.env.PROD && "serviceWorker" in navigator) {
    const scope = `${import.meta.env.BASE_URL}/`.replace("//", "/");
    window.addEventListener("load", () => {
      navigator.serviceWorker.register(`${scope}sw.js`, { scope }).catch(() => {
        // Without a service worker the site still works online.
      });
    });
  }
</script>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-text);
    overflow-wrap: break-word;
  }

  main:focus {
    outline: none;
  }

  .container {
    width: 100%;
    max-width: calc(1200px + 2 * var(--space-lg));
    margin-inline: auto;
    padding-inline: var(--space-lg);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 639px) {
    .container {
      padding-inline: var(--space-md);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  @media print {
    body > header,
    body > footer,
    .notice,
    .skip-link,
    .no-print {
      display: none !important;
    }
  }
</style>

<style>
  .skip-link {
    position: absolute;
    top: var(--space-xs);
    left: var(--space-xs);
    z-index: 1;
    padding: var(--space-xs) var(--space-md);
    background: var(--color-accent-main);
    color: var(--color-ink);
    font-weight: 700;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
    outline: var(--border-thick) solid var(--color-ink);
  }

  .notice {
    background: var(--color-accent-faded);
    color: var(--color-ink);
  }

  .notice p {
    margin-block: 0;
    padding-block: var(--space-sm);
    font-size: 16px;
    line-height: 1.5;
  }
</style>
